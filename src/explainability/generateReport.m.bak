function reportPath = generateReport(img, conceptVec, grade, rawScores, confidence, patientID, outputDir)
% GENERATEREPORT Composes an annotated HTML report with all pipeline outputs.
% All images and charts are embedded directly as Base64 Data URIs,
% making the HTML file 100% self-contained and portable when shared.
%
% Inputs:
%   img         - RGB original image
%   conceptVec  - Concept vector struct from buildConceptVector
%   grade       - ICDR grade (0-4)
%   rawScores   - 1x5 probability vector
%   confidence  - Calibrated scalar confidence (0-1)
%   patientID   - String patient identifier
%   outputDir   - Directory to save the report (default: 'reports/')
%
% Output:
%   reportPath - Absolute path to the generated self-contained HTML report file

    cfg = config();
    if nargin < 6 || isempty(patientID)
        patientID = 'PATIENT_001';
    end
    if nargin < 7 || isempty(outputDir)
        outputDir = cfg.paths.reports;
    end
    if ~isfolder(outputDir); mkdir(outputDir); end
    
    gradeName = cfg.classNames{min(5, max(1, grade + 1))};
    timestamp = datestr(now, 'yyyymmdd_HHMMSS');
    
    % --- Build overlays ---
    lesionOverlay = im2double(img);
    
    if isfield(conceptVec, 'maMask') && any(conceptVec.maMask(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.maMask, [1 0 0], 0.5);
    elseif isfield(conceptVec, 'masks') && isfield(conceptVec.masks, 'ma') && any(conceptVec.masks.ma(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.masks.ma, [1 0 0], 0.5);
    end
    
    if isfield(conceptVec, 'hmMask') && any(conceptVec.hmMask(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.hmMask, [0 0.3 1], 0.5);
    elseif isfield(conceptVec, 'masks') && isfield(conceptVec.masks, 'hm') && any(conceptVec.masks.hm(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.masks.hm, [0 0.3 1], 0.5);
    end
    
    if isfield(conceptVec, 'exMask') && any(conceptVec.exMask(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.exMask, [1 0.9 0], 0.5);
    elseif isfield(conceptVec, 'masks') && isfield(conceptVec.masks, 'ex') && any(conceptVec.masks.ex(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.masks.ex, [1 0.9 0], 0.5);
    end
    
    if isfield(conceptVec, 'cwsMask') && any(conceptVec.cwsMask(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.cwsMask, [0 1 1], 0.5);
    elseif isfield(conceptVec, 'masks') && isfield(conceptVec.masks, 'cws') && any(conceptVec.masks.cws(:))
        lesionOverlay = drawMaskOverlay(lesionOverlay, conceptVec.masks.cws, [0 1 1], 0.5);
    end
    
    % OD boundary
    if isfield(conceptVec, 'odMask') && any(conceptVec.odMask(:))
        odBoundary = bwperim(conceptVec.odMask);
        lesionOverlay = drawMaskOverlay(lesionOverlay, odBoundary, [0 1 0], 0.8);
    elseif isfield(conceptVec, 'masks') && isfield(conceptVec.masks, 'od') && any(conceptVec.masks.od(:))
        odBoundary = bwperim(conceptVec.masks.od);
        lesionOverlay = drawMaskOverlay(lesionOverlay, odBoundary, [0 1 0], 0.8);
    end
    
    % Grad-CAM overlay
    try
        [gradCamImg, ~] = explainGrade(img, conceptVec);
    catch
        gradCamImg = lesionOverlay;
    end
    
    % Evidence sentence
    evidenceSentence = generateEvidenceSentence(grade, conceptVec, confidence);
    
    % --- Save temporary image assets for Base64 conversion ---
    imgAssetsDir = fullfile(outputDir, 'assets');
    if ~isfolder(imgAssetsDir); mkdir(imgAssetsDir); end
    
    origPath    = fullfile(imgAssetsDir, sprintf('%s_%s_orig.png', patientID, timestamp));
    overlayPath = fullfile(imgAssetsDir, sprintf('%s_%s_overlay.png', patientID, timestamp));
    gradCamPath = fullfile(imgAssetsDir, sprintf('%s_%s_gradcam.png', patientID, timestamp));
    
    imwrite(im2uint8(img), origPath);
    imwrite(im2uint8(lesionOverlay), overlayPath);
    imwrite(gradCamImg, gradCamPath);
    
    % --- Bar chart for grade probabilities ---
    chartFig = figure('Visible', 'off', 'Color', 'w');
    b = bar(cfg.classLabels, rawScores, 'FaceColor', [0.15 0.45 0.85]);
    xlabel('ICDR Grade', 'FontSize', 11, 'FontWeight', 'bold');
    ylabel('Probability', 'FontSize', 11, 'FontWeight', 'bold');
    title('Grade Probability Distribution', 'FontSize', 12, 'FontWeight', 'bold');
    ylim([0 1]);
    grid on;
    set(gca, 'XTick', 0:4, 'XTickLabel', {'0: None', '1: Mild', '2: Mod', '3: Sev', '4: PDR'});
    chartPath = fullfile(imgAssetsDir, sprintf('%s_%s_chart.png', patientID, timestamp));
    saveas(chartFig, chartPath);
    close(chartFig);
    
    % Convert all 4 images to self-contained Base64 data URIs
    origB64    = fileToBase64(origPath);
    overlayB64 = fileToBase64(overlayPath);
    gradCamB64 = fileToBase64(gradCamPath);
    chartB64   = fileToBase64(chartPath);
    
    % Referable flag styling
    referableStr = 'NON-REFERABLE (Grade < 2)';
    referableColor = '#27ae60';
    if grade >= 2
        referableStr = 'REFERABLE DR DETECTED (Grade >= 2)';
        referableColor = '#c0392b';
    end
    
    % Format HM types string
    if isfield(conceptVec, 'hmType') && ~isempty(conceptVec.hmType)
        hmTypesStr = strjoin(unique(cellstr(conceptVec.hmType)), ', ');
    else
        hmTypesStr = 'None';
    end
    
    % --- Build Portable Self-Contained HTML ---
    html = ['<!DOCTYPE html>' ...
        '<html lang="en">' ...
        '<head>' ...
        '<meta charset="UTF-8">' ...
        '<meta name="viewport" content="width=device-width, initial-scale=1.0">' ...
        '<title>Netra AI DR Report - ' char(patientID) '</title>' ...
        '<style>' ...
        '* { box-sizing: border-box; }' ...
        'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 25px; background: #eef2f5; color: #2c3e50; }' ...
        '.container { max-width: 1100px; margin: 0 auto; }' ...
        '.header-card { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white; padding: 25px 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-bottom: 20px; }' ...
        '.header-card h1 { margin: 0 0 10px 0; font-size: 26px; }' ...
        '.badge { display: inline-block; padding: 8px 16px; border-radius: 20px; font-weight: bold; color: #fff; font-size: 0.95em; letter-spacing: 0.5px; }' ...
        '.section { background: #fff; border-radius: 12px; padding: 25px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }' ...
        '.section h2 { margin-top: 0; color: #1e3c72; border-bottom: 2px solid #eef2f5; padding-bottom: 10px; font-size: 20px; }' ...
        '.images-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 15px; }' ...
        'figure { margin: 0; background: #fdfdfd; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.04); text-align: center; }' ...
        'figure img { width: 100%; height: auto; display: block; }' ...
        'figcaption { padding: 10px; font-size: 13px; font-weight: 600; color: #475569; background: #f8fafc; border-top: 1px solid #e2e8f0; }' ...
        '.evidence-box { background: #eff6ff; border-left: 5px solid #3b82f6; padding: 18px 20px; border-radius: 6px; font-size: 15px; line-height: 1.6; color: #1e40af; margin-top: 10px; }' ...
        'table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }' ...
        'th, td { padding: 12px 16px; border-bottom: 1px solid #e2e8f0; text-align: left; }' ...
        'th { background: #f8fafc; color: #475569; font-weight: 700; }' ...
        'tr:hover { background: #f8fafc; }' ...
        '.disclaimer { background: #fffbeb; border: 1px solid #fef3c7; border-left: 5px solid #f59e0b; color: #92400e; padding: 15px 20px; border-radius: 8px; font-size: 13px; line-height: 1.5; }' ...
        '</style>' ...
        '</head>' ...
        '<body>' ...
        '<div class="container">' ...
        '<div class="header-card">' ...
        '<h1>&#128065; Netra AI &bull; Clinical Screening Report</h1>' ...
        '<p style="margin: 5px 0 0 0; opacity: 0.9;"><strong>Patient ID:</strong> ' char(patientID) ' &nbsp;|&nbsp; <strong>Date:</strong> ' datestr(now, 'mmmm dd, yyyy HH:MM') '</p>' ...
        '</div>' ...
        '<div class="section">' ...
        '<h2>Diagnostic Summary</h2>' ...
        '<div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap; margin-bottom: 15px;">' ...
        '<span style="font-size: 22px; font-weight: 700; color: #1e293b;">Grade ' num2str(grade) ': ' char(gradeName) '</span>' ...
        '<span class="badge" style="background: ' referableColor ';">' referableStr '</span>' ...
        '<span style="font-size: 15px; color: #64748b; margin-left: auto;"><strong>Calibrated Confidence:</strong> ' sprintf('%.1f%%', confidence*100) '</span>' ...
        '</div>' ...
        '<div class="evidence-box">' ...
        '<strong>Clinical Impression:</strong><br>' evidenceSentence ...
        '</div>' ...
        '</div>' ...
        '<div class="section">' ...
        '<h2>Multimodal Visual Evidence</h2>' ...
        '<div class="images-grid">' ...
        '<figure><img src="data:image/png;base64,' origB64 '"><figcaption>1. Original Fundus</figcaption></figure>' ...
        '<figure><img src="data:image/png;base64,' overlayB64 '"><figcaption>2. Lesion Overlay (MA=Red, HM=Blue, EX=Yellow, CWS=Cyan, OD=Green)</figcaption></figure>' ...
        '<figure><img src="data:image/png;base64,' gradCamB64 '"><figcaption>3. Visual Attention / Saliency</figcaption></figure>' ...
        '<figure><img src="data:image/png;base64,' chartB64 '"><figcaption>4. ICDR Class Probability</figcaption></figure>' ...
        '</div>' ...
        '</div>' ...
        '<div class="section">' ...
        '<h2>Quantitative Biomarkers</h2>' ...
        '<table>' ...
        '<thead><tr><th>Anatomical / Lesion Metric</th><th>Quantified Finding</th><th>Clinical Reference</th></tr></thead>' ...
        '<tbody>' ...
        '<tr><td>Microaneurysms (MA)</td><td><strong>' sprintf('%d', conceptVec.maCount) '</strong></td><td>Early vascular permeability indicator</td></tr>' ...
        '<tr><td>Haemorrhages (HM)</td><td><strong>' sprintf('%d (%s)', conceptVec.hmCount, hmTypesStr) '</strong></td><td>Focal retinal capillary rupture</td></tr>' ...
        '<tr><td>Hard Exudates Area</td><td><strong>' sprintf('%d px&sup2;', conceptVec.exArea) '</strong></td><td>Lipid deposition from vascular leakage</td></tr>' ...
        '<tr><td>Cotton-Wool Spots (CWS)</td><td><strong>' sprintf('%d', conceptVec.cwsCount) '</strong></td><td>Nerve fiber layer micro-infarction</td></tr>' ...
        '<tr><td>Neovascularization at Disc (NVD)</td><td><strong>' yesno(conceptVec.nvdFlag) '</strong></td><td>High-risk proliferative hallmark</td></tr>' ...
        '<tr><td>Peripheral Neovascularization (NVE)</td><td><strong>' yesno(conceptVec.nveFlag) '</strong></td><td>Active retinal neovascular proliferation</td></tr>' ...
        '<tr><td>Vessel Abnormality Score</td><td><strong>' sprintf('%.3f', conceptVec.vesselAbnormalityScore) '</strong></td><td>Morphological tortuosity index</td></tr>' ...
        '</tbody>' ...
        '</table>' ...
        '</div>' ...
        '<div class="disclaimer">' ...
        '<strong>&#9888; Clinical Notice:</strong> This report is synthesized by the Netra AI Clinical Decision Support System. It is intended to assist medical practitioners and must be correlated with clinical examination by an ophthalmologist.' ...
        '</div>' ...
        '</div>' ...
        '</body>' ...
        '</html>'];
    
    % Write fully self-contained report file
    reportPath = fullfile(outputDir, sprintf('report_%s_%s.html', patientID, timestamp));
    fid = fopen(reportPath, 'w', 'n', 'UTF-8');
    fprintf(fid, '%s', html);
    fclose(fid);
    
    fprintf('Self-contained report saved: %s\n', reportPath);
end

% -------------------------------------------------------------------------
function b64 = fileToBase64(filePath)
    if ~isfile(filePath)
        b64 = '';
        return;
    end
    fid = fopen(filePath, 'rb');
    bytes = fread(fid, [1, Inf], 'uint8=>uint8');
    fclose(fid);
    try
        b64 = char(matlab.net.base64encode(bytes));
    catch
        b64 = char(org.apache.commons.codec.binary.Base64.encodeBase64(bytes))';
    end
end

% -------------------------------------------------------------------------
function overlaid = drawMaskOverlay(imgD, mask, color, alpha)
    overlaid = imgD;
    for c = 1:3
        ch = overlaid(:,:,c);
        ch(mask) = (1 - alpha) * ch(mask) + alpha * color(c);
        overlaid(:,:,c) = ch;
    end
end

% -------------------------------------------------------------------------
function s = yesno(flag)
    if flag
        s = '<span style="color:#c0392b; font-weight:bold;">YES (Detected)</span>';
    else
        s = '<span style="color:#27ae60;">No</span>';
    end
end
